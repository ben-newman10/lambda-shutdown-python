# Terraform S3 Backend Configuration
# Copy this file to backend.conf and fill in your actual values
# DO NOT commit backend.conf to version control

bucket         = "lambda-shutdown-terraform-state"
key            = "terraform/state"
region         = "eu-west-2"

# Security: Enable encryption at rest
encrypt        = true

# Security: Use KMS key for encryption (recommended)
# Uncomment and replace with your KMS key ARN for enhanced security
# kms_key_id     = "arn:aws:kms:eu-west-2:ACCOUNT_ID:key/KEY_ID"

# State locking with DynamoDB (recommended)
# Uncomment and specify your DynamoDB table name
# dynamodb_table = "terraform-state-lock"

# ============================================
# SECURITY RECOMMENDATIONS FOR S3 BUCKET
# ============================================
# 
# 1. Enable versioning on the S3 bucket:
#    aws s3api put-bucket-versioning --bucket lambda-shutdown-terraform-state --versioning-configuration Status=Enabled
#
# 2. Enable server-side encryption on the S3 bucket:
#    aws s3api put-bucket-encryption --bucket lambda-shutdown-terraform-state --server-side-encryption-configuration '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}'
#
# 3. Block all public access to the S3 bucket:
#    aws s3api put-public-access-block --bucket lambda-shutdown-terraform-state --public-access-block-configuration "BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true"
#
# 4. Use bucket policies to restrict access to specific IAM roles/users
#
# 5. Enable MFA delete on the S3 bucket (optional but recommended for production):
#    aws s3api put-bucket-versioning --bucket lambda-shutdown-terraform-state --versioning-configuration Status=Enabled,MFADelete=Enabled --mfa "SERIAL_NUMBER TOKEN"
#
# 6. Enable CloudTrail logging for the S3 bucket to audit access